{
  "name": "@minamorl/berylx-presets",
  "version": "0.1.0",
  "description": "Typed, inspectable data presets for Berylx.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minamorl/berylx-presets.git"
  },
  "homepage": "https://github.com/minamorl/berylx-presets#readme",
  "bugs": {
    "url": "https://github.com/minamorl/berylx-presets/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src",
    "examples",
    "fixtures",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:core": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:types": "tsc --noEmit -p tsconfig.types.json",
    "test": "npm run build && npm run test:core && npm run test:types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compare": "node scripts/compare.mjs",
    "compare:write": "node scripts/compare.mjs --write",
    "test:package": "node scripts/check-package.mjs",
    "example": "npm run build && tsc -p tsconfig.test.json && node scripts/run-example.mjs",
    "check": "npm run format:check && npm test && npm run typecheck && npm run compare && npm run test:package"
  },
  "peerDependencies": {
    "@minamorl/berylx": "^0.3.1"
  },
  "devDependencies": {
    "@minamorl/berylx": "0.3.1",
    "@types/node": "24.10.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
